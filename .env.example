# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID старосты (и помощников) через запятую.
# Узнать свой ID: написать боту @userinfobot
ADMIN_IDS=111111111

# Часовой пояс по умолчанию (можно поменять в админ-панели)
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных
DB_PATH=data/vedomost.db

# Необязательно, но рекомендуется: чтобы бот сам считывал ВСЕХ участников чата.
# Получить: https://my.telegram.org → API development tools → создать приложение.
# Без этих ключей бот узнаёт студентов, только когда они пишут/заходят в чат
# или нажимают кнопку.
API_ID=
API_HASH=
